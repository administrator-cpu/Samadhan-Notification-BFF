{
  "name": "samadhan-notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Samadhan push notification service: consumes the backend 'notifications' queue and delivers via Expo Push.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx src/scripts/migrate.ts",
    "sync-legacy-tokens": "node dist/scripts/sync-legacy-tokens.js",
    "send-test": "node dist/scripts/send-test.js",
    "send-test-call": "node dist/scripts/send-test-call.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/rules.test.ts test/calls.test.ts",
    "requeue-dlq": "node dist/scripts/requeue-dlq.js",
    "test:e2e": "tsx --test test/integration.test.ts",
    "test:calls": "tsx --test test/calls.test.ts"
  },
  "dependencies": {
    "bullmq": "^5.77.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
